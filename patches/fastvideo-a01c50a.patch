+def quantize_fp8_weight(weight: torch.Tensor, granularity: str = "tensor") -> tuple[torch.Tensor, torch.Tensor]:
+    """``(fp8 weight, float32 scale)`` of a dense ``[out, in]`` weight: one scale per output channel or per tensor."""
+    if granularity == "channel":
+        w_absmax = weight.detach().abs().amax(dim=1).nan_to_num().float()
+        w_scale = (w_absmax / FP8_MAX).clamp(min=FP8_MIN_SCALE)
+        w_fp8 = (weight / w_scale.to(weight.dtype).unsqueeze(1)).clamp(-FP8_MAX, FP8_MAX).to(FP8_DTYPE)
+    else:
+        w_absmax = weight.detach().abs().amax().nan_to_num().to(torch.float32)
+        w_scale = (w_absmax / FP8_MAX).clamp(min=FP8_MIN_SCALE).view(1)
+        w_fp8 = (weight / w_scale.to(weight.dtype)).clamp(-FP8_MAX, FP8_MAX).to(FP8_DTYPE)
+    return w_fp8.contiguous(), w_scale.to(torch.float32)
+

+def _page_locked(numel_by_dtype: dict[torch.dtype, int]) -> dict[torch.dtype, torch.Tensor]:
+    """One page-locked host buffer per dtype, registered with CUDA (the pinned caching allocator would round every
+    allocation up to a power of two)."""
+    slabs = {}
+    for dtype, numel in numel_by_dtype.items():
+        slab = torch.empty(numel, dtype=dtype)
+        err = torch.cuda.cudart().cudaHostRegister(slab.data_ptr(), slab.numel() * slab.element_size(), 0)
+        if int(err) != 0:
+            logger.warning("cudaHostRegister failed (%s); the dense FP8 sources stay pageable", err)
+        slabs[dtype] = slab
+    return slabs
+

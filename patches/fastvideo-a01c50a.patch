+def _yuv420_planes(pixels: torch.Tensor) -> torch.Tensor:
+    """[1, 3, T, H, W] pixels in [0, 1] -> [T, H * W * 3 / 2] uint8 yuv420p, BT.601 limited range like ffmpeg's default."""
+    rgb = (pixels[0] * 255).clamp_(0, 255).to(torch.uint8).float().transpose(0, 1)
+    red, green, blue = rgb.unbind(1)
+    luma = 16 + 0.256788 * red + 0.504129 * green + 0.097906 * blue
+    red, green, blue = F.avg_pool2d(rgb, 2).unbind(1)
+    cb = 128 - 0.148223 * red - 0.290993 * green + 0.439216 * blue
+    cr = 128 + 0.439216 * red - 0.367788 * green - 0.071427 * blue
+    return torch.cat([plane.flatten(1) for plane in (luma, cb, cr)], dim=1).round_().clamp_(0, 255).to(torch.uint8)

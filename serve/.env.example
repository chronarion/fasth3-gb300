# Copy to serve/.env (docker compose reads it from the serve/ directory) and fill in.
# The GB300 by CDI name; `docker info` lists the discovered devices. On a DGX Station use the UUID (index 0 is the RTX).
FASTH3_GPU=nvidia.com/gpu=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Hugging Face cache filled by tools/download_models.sh (mounted read-only).
FASTH3_HF=/path/to/hf
# Optional (defaults in docker-compose.yml):
# FASTH3_IMAGE=fasth3-gb300
# FASTH3_PORT=8101
# FASTH3_UID=1000
# FASTH3_GID=1000
# FASTH3_MEDIA=./media      # reference inputs under media/in, outputs under media/out
# FASTH3_CACHE=./cache      # JIT and compile caches

# Drafts: the max profile plus FastVideo's 8-layer NVFP4 video decoder (fast tier: 28.5 dB / LPIPS 0.068 against the FP32
# decoder on FastH3 V2 clips, per its model card, vs 37.9 dB / 0.010 for the default 36-layer quality tier). Softer
# detail; use it to iterate on prompts, then render with another profile.
#   docker compose --env-file profiles/preview.env up -d t2v
FV_ARGS=--generator.model_path /root/.cache/huggingface/composed/fasth3-qad-v2-fullvae --generator.engine.compile.vae_enabled true --generator.engine.quantization.transformer_quant NVFP4 --generator.engine.quantization.layer_profile h3_dit_vsa
FASTVIDEO_H3_FP8_ATTN=1
FASTVIDEO_H3_VAE_NVFP4_DECODER=/root/.cache/huggingface/hub/models--FastVideo--FastH3-NVFP4-VAE-Decoder/snapshots/bd0c248f2a0f57ca643b3df2ac1f375fa55101fb/fast-8L/decoder-nvfp4.safetensors
